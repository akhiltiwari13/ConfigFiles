# See https://git-scm.com/docs/git-config

[alias]
	co = checkout
	br = branch
	ci = commit
	st = status
	staash = stash --all
[core]
	editor = nvim
	# Detective layer of the worktree location policy (see AGENTS.md "Parallel
	# worktrees"). ~/.config/bin/git prevents off-policy `git worktree add`, but
	# only for callers that resolve git through PATH; this hook fires whatever
	# binary was invoked, so it catches libgit2 tools and absolute /usr/bin/git.
	# NOTE: hooksPath overrides .git/hooks for EVERY repo, so the hook dispatches
	# to a repo's own post-checkout first. Keep that behaviour if you add hooks.
	hooksPath = ~/.config/git/hooks
[init]
	defaultBranch = master
[pull]
	rebase = true 			 # Rebase (instead of merge) on pull
[push]
	autoSetupRemote = true   # Automatically set upstream branch on push
[diff]
	algorithm = histogram    # Clearer diffs on moved/edited lines
	colorMoved = plain       # Highlight moved blocks in diffs
	mnemonicPrefix = true    # More intuitive refs in diff output
[commit]
	verbose = true           # Include diff comment in commit message template
[column]
	ui = auto 			     # Output in columns when possible
[branch]
	sort = -committerdate    # Sort branches by most recent commit first
[tag]
	sort = -version:refname  # Sort version numbers as you would expect
[rerere]
	enabled = true           # Record and reuse conflict resolutions
	autoupdate = true        # Apply stored conflict resolutions automatically
[user]
	name = akhil tiwari
	email = akhiltiwari.13@gmail.com

# Route clones of work repos through the github-work SSH alias.
# Top-level (not inside includeIf) because includeIf gitdir: doesn't fire
# during `git clone` — the new gitdir doesn't exist yet.
[url "git@github-work:<work-repo-name>/"]
	insteadOf = git@github.com:<work-repo-name>/

# Use work email for work projects
[includeIf "gitdir:~/Work/projects/<work-repo-root>/"]
	path = ~/.config/git/config-work
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
