Host *
    AddKeysToAgent yes

Host github
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes

# Catches raw `git@github.com:...` URLs so they route to the personal key.
# gitconfig's url.insteadOf: rewrites them to `git@github-work:...` before SSH connects.
Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes

# Host github-work
#     HostName github.com
#     User git
#     IdentityFile ~/.ssh/id_ed25519_<some-other-id-file>
#     IdentitiesOnly yes


Host quomptblr
    HostName  sambhav-nucbox
    # this env forwarding would work over regular ssh sessions.
    # SendEnv LANG LC_* 
    SetEnv LANG=en_US.UTF-8
    User atiwari
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    ForwardAgent yes
    ServerAliveInterval 60
    ServerAliveCountMax 3
    TCPKeepAlive yes
    # enabling display server forwarding would not work for tailscaled connections.
    # ForwardX11 yes
    # ForwardX11Trusted no
    # ForwardX11Timeout 596h
    Compression no # tailscale is already encrypted.
